# Template for LOCAL development. For production change at least:
#   APP_ENV=production
#   APP_DEBUG=false            (true exposes stack traces and environment details)
#   APP_URL=https://symbiot.npsoft.ro
#   LOG_LEVEL=warning
#   SESSION_ENCRYPT=true       (enabling it logs every user out once)
#   SESSION_SECURE_COOKIE=true
APP_NAME="Symbiot v1.0"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://symbiot.local

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE="symbiot"
DB_USERNAME=developer
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Defaults to true when APP_URL starts with https://
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

APP_DEFAULT_DISTANCE_NUMBER=10
APP_DEFAULT_DISTANCE_UNIT="KM"

# Provider keys stay server-side. POI definitions are in config/poi.php.
GEOAPIFY_KEY=

# Registration country: trust CF-IPCountry only when the site is served through Cloudflare.
TRUST_CLOUDFLARE_COUNTRY=false
# Look up the country of the registering IP via ipwho.is (sends the IP to a third party).
IP_COUNTRY_LOOKUP=true
TOMTOM_API_KEY=
WAZE_API_URL=https://api.openwebninja.com/waze
WAZE_API_KEY=
PETROLEUM_CHECK=resources/certs/sectigo-dv-r36.pem
TRACKING_POINT_MAX_AGE_HOURS=48
TRACKING_POINT_MAX_FUTURE_MINUTES=5
TRACKING_PLANNED_ROUTE_MAX_COORDINATES=10000
TRACKING_PLANNED_ROUTES_MAX_PER_USER=200
TRACKING_WEB_SESSION_LIST_MAX=500
TRACKING_WEB_POINTS_MAX=10000
SANCTUM_TOKEN_EXPIRATION=43200

# FlightAware AeroAPI (optional; enables airport arrivals/departures)
FLIGHTAWARE_API_KEY=
FLIGHTAWARE_BASE_URL=https://aeroapi.flightaware.com/aeroapi
